# ---- Database ----
# Local dev with docker-compose Postgres:
DATABASE_URL="postgresql://capital:capital@localhost:5432/capital?schema=public"

# ---- Auth ----
# Secret used to sign the session JWT. Generate a strong one, e.g.:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Single-user login credentials. The seed script hashes APP_PASSWORD (bcrypt)
# into the User row. Change the password, then re-run `npm run db:seed`.
APP_EMAIL="admin@capital.local"
APP_PASSWORD="capital123"

# ---- Integrations (added in later stages) ----
# Google Sheets (expenses). Either provide the raw service-account JSON in
# GOOGLE_SERVICE_ACCOUNT_JSON (prod), or a path to the key file (dev).
GOOGLE_SHEETS_ID="1Bf9IdxA5xDU9f0wU-i8FUMhc0WQSdD4vXFuElYfr7AQ"
GOOGLE_SHEETS_EXPENSES_TAB="Отчет"
GOOGLE_SHEETS_CATEGORIES_TAB="Категории "
GOOGLE_APPLICATION_CREDENTIALS="./secrets/google-service-account.json"
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# FX: RUB per 1 USD fallback when CBR (cbr-xml-daily.ru) is unreachable.
FX_USD_RUB="95"
# Expense categories to exclude (transfers/cash-outs), comma-separated.
EXPENSE_EXCLUDE="Снятие наличных,Обналичивание крипты"

# ---- Crypto (Stage 6): prices + on-chain balances ----
# CoinMarketCap key for prices (BTC/ETH/TRX/TON/USDT...).
CMC_API_KEY=""
# Optional chain endpoints/keys (sensible public defaults are used if empty):
# EVM_RPC_URL=""          # default https://eth.llamarpc.com (native ETH + USDT/USDC)
# BSC_RPC_URL=""          # default https://bsc-rpc.publicnode.com (native BNB + USDT/USDC BEP20)
# BTC_API_URL=""          # default https://blockstream.info/api
# TRONGRID_API_URL=""     # default https://api.trongrid.io
# TRONGRID_API_KEY=""
# TON_API_URL=""          # default https://toncenter.com/api/v2
# TON_API_KEY=""

# ---- Telegram (agency balances) ----
# Bot token from @BotFather. The bot must be a member of the company chat
# where the employee posts the daily agency balances, with group privacy mode
# DISABLED (BotFather → /setprivacy → Disable) so it can read plain messages.
TELEGRAM_BOT_TOKEN=""
# Restrict processing to one chat. Get the id from getUpdates (chat.id, a
# negative number for groups). Strongly recommended.
TELEGRAM_CHAT_ID=""
# Regex (case-insensitive) marking a message as the balances report. A message
# also qualifies if it has ≥2 parseable "name — amount" lines. Default:
# "остат|баланс|агентств".
TELEGRAM_REPORT_MARKER=""
# Auto-create agencies seen in the report but not yet in the dashboard.
TELEGRAM_AGENCY_AUTOCREATE="true"

# ---- Background worker (cron) ----
# Shared secret the worker uses to call the sync endpoints.
CRON_SECRET="change-me-cron-secret"
SYNC_CRYPTO_CRON="*/10 * * * *"
SYNC_EXPENSES_CRON="0 * * * *"
SYNC_TELEGRAM_CRON="*/15 * * * *"
