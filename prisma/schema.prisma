// Capital Dashboard — DB schema.
// Fields mirror the prototype mock contracts (STORE/CHARTS, WALLETS/AGENCIES/
// HISTORY/DEFAULT_RESERVES). One row in each table = one real record once the
// integrations (Stages 4–6) start writing live data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSource {
  sync
  sheets
  manual
}

enum AssetBucket {
  crypto
  vehicles
  cash
  other
}

enum Chain {
  BTC
  ETH
  BSC
  TRX
  TON
}

enum WalletScope {
  personal
  company
}

enum WalletGroup {
  clean
  dirty
}

enum WalletKind {
  main
  small
}

enum SnapshotScope {
  personal
  crypto
  company
}

/// Single app user (password login). Multi-user ready, but seeded with one.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String   @default("admin")
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Personal assets shown on Обзор / Активы (manual + synced aggregates).
model Asset {
  id        String      @id @default(cuid())
  slug      String?     @unique // stable id for seeded rows (e.g. "crypto")
  icon      String
  name      String
  value     Decimal     @db.Decimal(18, 2) // always USD (converted from `currency`)
  delta     Decimal?    @db.Decimal(6, 2)
  amount    Decimal?    @db.Decimal(30, 8) // token quantity (crypto holdings)
  symbol    String?     // coin ticker for crypto holdings (BTC/ETH/…)
  /// Currency the user entered the value in ("USD" | "RUB"). RUB assets keep the
  /// original amount in `nativeValue` and are shown in USD at the current CBR rate.
  currency    String   @default("USD")
  nativeValue Decimal? @db.Decimal(18, 2) // original amount in `currency` (when not USD)
  /// Show this asset on the Инвестиции tab (in "Другие инвестиции"). Crypto and
  /// TON numbers default to true; other manual assets default to false.
  investment  Boolean  @default(false)
  source    DataSource
  bucket    AssetBucket
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

/// Blockchain addresses to sync (both contours). Company USDT wallets live on
/// Tron (TRC20), Ethereum (ERC20) or BNB Smart Chain (BEP20) and carry group
/// (clean/dirty) and kind (main/small); personal crypto does not.
model Wallet {
  id           String       @id @default(cuid())
  slug         String?      @unique // stable id for seeded rows (e.g. "w_clean_1")
  scope        WalletScope
  chain        Chain
  token        String // "USDT", "BTC", "ETH", "TRX", "TON"
  address      String
  label        String
  group        WalletGroup?
  kind         WalletKind?
  balance      Decimal      @default(0) @db.Decimal(30, 8) // token units
  balanceUsd   Decimal      @default(0) @db.Decimal(18, 2)
  holdingsJson Json? // per-coin breakdown for this address: [{symbol,amount,usd}]
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())

  @@unique([chain, address, token])
}

/// Ad agency balances — manual entry per agency.
model Agency {
  id        String   @id @default(cuid())
  slug      String?  @unique
  platform  String
  name      String
  balance   Decimal  @db.Decimal(18, 2)
  enteredBy String
  updatedAt DateTime @default(now()) // staleDays derived from now() - updatedAt
  createdAt DateTime @default(now())
}

/// What-if reserves (singleton). Formula: available = wallets + agencies
/// − salaryWeekly×salaryWeeks − tech − agencyReserve.
model Reserve {
  id            String   @id @default("default")
  salaryWeekly  Int
  salaryWeeks   Int
  tech          Int
  /// Резерв на рекламные агентства (manual buffer; usually balances + reserve = $40k).
  agencyReserve Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// Dividend payouts — manual entry; YTD is an aggregate.
model Dividend {
  id        String   @id @default(cuid())
  name      String
  amount    Decimal  @db.Decimal(18, 2)
  paidAt    DateTime
  createdAt DateTime @default(now())
}

/// Monthly expense totals (imported from Google Sheets, Stage 5).
model ExpenseMonth {
  id         String   @id @default(cuid())
  label      String
  monthStart DateTime
  value      Decimal  @db.Decimal(18, 2)

  @@unique([monthStart])
}

/// Expense breakdown by category for a given period.
model ExpenseCategory {
  id     String  @id @default(cuid())
  name   String
  value  Decimal @db.Decimal(18, 2)
  period String // "2025-06"

  @@unique([period, name])
}

/// Weekly expense totals (last ~12 weeks, from Google Sheets).
model ExpenseWeek {
  id      String  @id @default(cuid())
  label   String  // "01.06–07.06"
  weekEnd String  @unique // "YYYY-MM-DD"
  value   Decimal @db.Decimal(18, 2) // USD

  @@index([weekEnd])
}

/// Expense breakdown by subcategory per week (for the expandable tree in weekly mode).
model ExpenseWeekSubcategory {
  id      String  @id @default(cuid())
  weekEnd String  // "YYYY-MM-DD"
  parent  String  // Статья
  name    String  // Подстатья
  value   Decimal @db.Decimal(18, 2) // USD

  @@unique([weekEnd, parent, name])
  @@index([weekEnd, parent])
}

/// Expense breakdown by category for a given week.
model ExpenseWeekCategory {
  id      String  @id @default(cuid())
  weekEnd String  // "YYYY-MM-DD"
  name    String
  value   Decimal @db.Decimal(18, 2) // USD

  @@unique([weekEnd, name])
}

/// Expense breakdown by subcategory (Подстатья) within a category, per period.
model ExpenseSubcategory {
  id     String  @id @default(cuid())
  period String
  parent String // Статья
  name   String // Подстатья
  value  Decimal @db.Decimal(18, 2)

  @@index([period, parent])
}

/// Individual personal-expense payments from the ДДС ledger (Дата/Сумма/
/// Комментарий/Статья/Подстатья), for drilling a subcategory down to single
/// payments. Amounts are scaled so a subcategory's payments sum to its total.
model ExpenseTransaction {
  id      String  @id @default(cuid())
  period  String  // "YYYY-MM"
  parent  String  // Статья
  sub     String  // Подстатья
  date    String  // "YYYY-MM-DD"
  comment String  // столбец H («Комментарий к платежу»)
  value   Decimal @db.Decimal(18, 2) // USD

  @@index([period, parent, sub])
}

/// Same, bucketed per week (last ~12 weeks) for the weekly view.
model ExpenseWeekTransaction {
  id      String  @id @default(cuid())
  weekEnd String  // "YYYY-MM-DD"
  parent  String
  sub     String
  date    String
  comment String
  value   Decimal @db.Decimal(18, 2)

  @@index([weekEnd, parent, sub])
}

/// Monthly personal income (mostly dividends), imported from the ДДС Google
/// Sheet ledger. Drives the income series on the расходы/доходы chart. Keyed by
/// period "YYYY-MM"; value is in USD (the ledger is kept in USD).
model MonthlyIncome {
  period   String   @id // "2025-12"
  usd      Decimal  @db.Decimal(18, 2)
  source   String   @default("dds") // "dds" (sheet) | "manual"
  syncedAt DateTime @default(now())
}

/// Expense rows reclassified as investments (not spendable — e.g. education).
/// Pulled out of the expense totals/categories and shown separately on
/// Инвестиции, explicitly NOT counted in the portfolio total.
model OtherInvestment {
  id     String  @id @default(cuid())
  period String // "2025-12"
  parent String // Статья (e.g. "Образование и развитие")
  name   String // Подстатья (e.g. "Коучи\преподаватели\наставники")
  value  Decimal @db.Decimal(18, 2) // USD

  @@unique([period, parent, name])
}

/// Coin allocation for the investments view (derived from wallets in Stage 6).
model CoinAllocation {
  id     String @id @default(cuid())
  ticker String @unique
  pct    Int
}

/// Capital history — one row per successful sync; drives history charts and
/// the "обновлено N мин назад" label.
model CapitalSnapshot {
  id         String        @id @default(cuid())
  scope      SnapshotScope
  value      Decimal       @db.Decimal(18, 2)
  capturedAt DateTime      @default(now())

  @@index([scope, capturedAt])
}

/// Latest token prices in USD (CoinGecko/Binance, Stage 6).
model PriceCache {
  symbol    String   @id // "BTC", "ETH", "TRX", "TON", "USDT"
  usd       Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())
}

/// Last successful sync per data source (for badges / "N мин назад").
model SyncState {
  source       String    @id // "crypto", "sheets"
  lastSyncedAt DateTime?
  ok           Boolean   @default(true)
}

/// Daily USD→RUB rate cache (CBR), keyed by date "YYYY-MM-DD".
model FxRate {
  date      String   @id // "YYYY-MM-DD"
  usdRub    Decimal  @db.Decimal(18, 6) // RUB per 1 USD
  source    String   @default("cbr")
  fetchedAt DateTime @default(now())
}

/// CoinLink accounts payable (кредиторская задолженность) — synced from the
/// external read-only `coinlink_payable` view. Singleton: one current figure
/// plus a per-partner breakdown. Subtracted from the company "available to
/// withdraw" total. `periodFrom` records the lower bound of the synced window
/// (Feb 1 of the current year); the upper bound is the sync moment.
model CoinlinkPayable {
  id         String    @id @default("default")
  totalUsdt  Decimal   @default(0) @db.Decimal(18, 2)
  partners   Json? // [{ partner, debt }] sorted by debt desc
  periodFrom DateTime? // lower bound of the synced window
  lastSyncedAt DateTime?
  ok         Boolean   @default(true)
}

/// Cursor for the Telegram agency-balances integration. Stores the
/// getUpdates offset (last processed update_id) so messages from the chat
/// aren't reprocessed, plus diagnostics about the last consumed report.
model TelegramState {
  id            String    @id @default("default")
  offset        BigInt    @default(0) // next getUpdates offset (lastUpdateId + 1)
  lastChatId    String? // chat the last report came from
  lastMessageAt DateTime? // timestamp of the last consumed balances message
  updatedAt     DateTime  @updatedAt
}
